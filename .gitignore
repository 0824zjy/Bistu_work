cat > .gitignore <<'EOF'
# 权重文件后缀
*.pth
*.safetensors
*.pt
*.bin
*.ckpt
*.model

# 训练输出、检查点目录
*/model_out/
*/checkpoints/
*/results/
*/pretrained_pth/
*/archive_before_standard/

# BGDiff大模型
BGDiff/Ours/models/

# 边界先验npy资源
BGDiff/asset/maps/*.npy

# 数据集文件夹
ISIC2018/
PH2/
*.nii.gz
*.h5
*.npz
*.npy

# 环境、日志、缓存
env_patch/
*.log
*.out
__pycache__/
*.pyc
.vscode/
.DS_Store
EOF


# # 查看改动
# git status
# # 把所有修改加入暂存
# git add .
# # 填写更新说明
# git commit -m "此处写更新内容，例如：修复分割指标计算bug"
# # 推送到github
# git push# 备份文件
*.bak_*
# 日志图片、pid运行日志（可选，不想上传可视化图就开启）
# Work3_BEF_SBG/logs/diffusion/image_log_Stage1-2/
# Work3_BEF_SBG/logs/pids/
# 新日志实验文件夹
Work3_BEF_SBG/logs/5p_seed0_EHswap_E15_M35_H50/
Work3_BEF_SBG/logs/diffusion/stage1_bef_sbg_chfs_v2_5p_seed0/
